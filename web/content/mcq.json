      "lang": "python",
      "difficulty": "easy",
      "prompt": "What does this print?",
      "code": ["x = [1, 2, 3]", "y = x", "y.append(4)", "print(len(x))"],
      "options": ["3", "4", "AttributeError", "2"],
      "answerIndex": 1,
      "explanation": "y = x copies the reference, not the list. Appending through y grows the same object, so len(x) is 4.",
      "tags": ["references", "lists"]
    },
    {
